datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String
  phone     String
  role      String   @default("Admin") // Admin, Editor
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String
  address   String
  city      String
  state     String
  pincode   String
  regDate   DateTime @default(now())
  lastLogin DateTime @default(now())
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  category     String
  fabric       String
  color        String
  size         String   // Stored as comma-separated values (e.g. "S,M,L")
  price        Float
  availability String   @default("In Stock") // In Stock, New Arrival, Best Seller
  occasion     String   @default("Festive")
  image        String
  rating       Float    @default(5.0)
  stock        Int      @default(10)
  sku          String   @unique
  description  String
  videoUrl     String   @default("")
  featured     Boolean  @default(false)
  trending     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Subcategory {
  id         Int    @id @default(autoincrement())
  name       String
  categoryId Int
}

model Order {
  id             Int      @id @default(autoincrement())
  userId         Int
  customerName   String
  phone          String
  email          String
  address        String
  paymentMethod  String   @default("COD") // COD, UPI, Razorpay
  paymentStatus  String   @default("Pending") // Pending, Paid
  orderStatus    String   @default("Pending") // Pending, Confirmed, Packed, Shipped, Delivered, Cancelled
  invoiceNumber  String   @unique
  trackingNumber String   @default("")
  shippingFee    Float    @default(0.0)
  tax            Float    @default(0.0)
  discount       Float    @default(0.0)
  subtotal       Float
  grandTotal     Float
  createdAt      DateTime @default(now())
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  qty       Int
  price     Float
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  transactionId String   @unique
  amount        Float
  status        String
  createdAt     DateTime @default(now())
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
}

model Cart {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  qty       Int @default(1)
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  author    String
  rating    Int
  content   String
  status    String   @default("Pending") // Pending, Approved, Rejected
  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  author    String
  content   String
  reply     String   @default("")
  status    String   @default("Pending") // Pending, Approved, Rejected
  createdAt DateTime @default(now())
}

model Coupon {
  id       Int    @id @default(autoincrement())
  code     String @unique
  discount Float
  expiry   String
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Banner {
  id    Int    @id @default(autoincrement())
  title String
  image String
  type  String // Hero, Homepage, Offer
  link  String @default("#")
}

model Settings {
  id             Int    @id @default(autoincrement())
  gst            Float  @default(18.0)
  shipping       Float  @default(150.0)
  email          String @default("atelier@achira.com")
  phone          String @default("+91 98765 43210")
  storeName      String @default("ACHIRA Atelier")
  paymentGateway String @default("Razorpay")
  logo           String @default("")
  favicon        String @default("")
  socialLinks    String @default("") // Comma-separated or JSON
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   // Register, Login, Order, Review, Contact
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LoginActivity {
  id        Int      @id @default(autoincrement())
  userId    Int?
  adminId   Int?
  action    String   // Create Account, Login, Logout, Change Password, Update Profile
  ip        String
  browser   String
  os        String
  device    String
  createdAt DateTime @default(now())
}

model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?
  keyword   String
  createdAt DateTime @default(now())
}
